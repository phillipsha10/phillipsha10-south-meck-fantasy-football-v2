// Calculates all-time career totals for a person from YEAR_BY_YEAR.
// Nothing here needs to be edited by hand — it's all derived.
export function getCareerStats(personId) {
  const seasons = YEAR_BY_YEAR[personId] || [];
  const totals = seasons.reduce(
    (acc, s) => {
      acc.wins += s.wins;
      acc.losses += s.losses;
      if (s.finish === 'Champion') acc.championships += 1;
      if (s.finish === 'Runner-Up') acc.runnerUps += 1;
      if (s.finish === 'Last Place') acc.lastPlaces += 1;
      return acc;
    },
    { wins: 0, losses: 0, championships: 0, runnerUps: 0, lastPlaces: 0 }
  );
  const totalGames = totals.wins + totals.losses;
  totals.winPct = totalGames > 0 ? (totals.wins / totalGames) * 100 : 0;
  totals.seasonsPlayed = seasons.length;
  return totals;
}
